---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import drawing from '../assets/macauley-drawing.svg?raw';
import {
  site,
  stages,
  featuredCaseStudies,
  deliveredSystems,
  practices,
  skills,
  journey,
  qualifications,
} from '../content/site';
---

<Base>
  <section class="wrap hero">
    <div class="hero-top">
      <div>
        <h1>
          I turn complicated business processes into Power Platform solutions people can rely on.
        </h1>
        <p class="intro">
          I combine automation, data, AI and thoughtful UX/UI to build secure systems that make work
          easier—from discovery through to production support. <a href="#work">See the work</a>, or
          find me on <a href={site.linkedin} rel="noopener me">LinkedIn</a>.
        </p>
      </div>
      <div class="portrait portrait-drawing" role="img" aria-label="A line drawing of Macauley, smiling">
        <Fragment set:html={drawing} />
      </div>
    </div>

    <nav class="lifecycle" aria-label="Delivery stages">
      <ol>
        {
          stages.map((s) => (
            <li>
              <a href={`#${s.id}`}>
                <span class="stage-name">{s.name}</span>
                <span class="stage-summary">{s.summary}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
  </section>

  <section class="section section-wash" id="work" aria-labelledby="work-h">
    <div class="wrap">
      <div class="section-head">
        <h2 id="work-h">Selected Power Platform work</h2>
        <p>
          Three examples of the business problem, my role and what changed. Client names and
          identifying screenshots stay confidential.
        </p>
      </div>

      <div class="case-studies">
        {
          featuredCaseStudies.map((study) => (
            <article class="case-study">
              <h3>{study.title}</h3>
              <dl class="formula case-formula">
                <div>
                  <dt>Context</dt>
                  <dd>{study.context}</dd>
                </div>
                <div>
                  <dt>My role</dt>
                  <dd>{study.role}</dd>
                </div>
                <div>
                  <dt>What changed</dt>
                  <dd>{study.change}</dd>
                </div>
                <div>
                  <dt>Status</dt>
                  <dd>{study.status}</dd>
                </div>
                <div>
                  <dt>Built with</dt>
                  <dd>{study.tech}</dd>
                </div>
              </dl>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" id="projects" aria-labelledby="projects-h">
    <div class="wrap">
      <div class="section-head">
        <h2 id="projects-h">More systems I’ve delivered</h2>
        <p>Production integrations, automation and model-driven work across the wider platform.</p>
      </div>

      <div class="systems">
        {
          deliveredSystems.map((system) => (
            <article class="system">
              <h3>{system.title}</h3>
              <p>{system.body}</p>
              <p class="status">{system.result}</p>
              <p class="tech">{system.tech}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-wash" id="process" aria-labelledby="process-h">
    <div class="wrap">
      <div class="section-head">
        <h2 id="process-h">How I take work from idea to live service</h2>
        <p>Practical delivery from the first requirement through to production support.</p>
      </div>
    </div>

    <nav class="stagebar" aria-label="Stages in this section">
      <ol class="wrap">
        {
          stages.map((s) => (
            <li>
              <a href={`#${s.id}`} data-stage={s.id}>
                {s.name}
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <div class="wrap">
      <ol class="stages">
        {
          stages.map((s) => (
            <li class="stage" id={s.id}>
              <h3>{s.name}</h3>
              <div class="stage-body">
                <p class="lead">{s.lead}</p>

                {s.id === 'build' && (
                  <figure class="compare">
                    <figcaption>Contact search on a nine-million-row table</figcaption>
                    <div class="compare-row">
                      <span class="compare-label">Before</span>
                      <span class="compare-track">
                        <span class="compare-bar compare-before" />
                      </span>
                      <span class="compare-value">about 2 minutes</span>
                    </div>
                    <div class="compare-row">
                      <span class="compare-label">After</span>
                      <span class="compare-track">
                        <span class="compare-bar compare-after" />
                      </span>
                      <span class="compare-value">under 5 seconds</span>
                    </div>
                  </figure>
                )}

                {s.id === 'release' && (
                  <figure class="pipeline">
                    <ol>
                      <li>Dev</li>
                      <li>UAT</li>
                      <li>Production</li>
                    </ol>
                    <figcaption>
                      One managed solution moves through all three. Connection references and
                      environment variables are set per environment.
                    </figcaption>
                  </figure>
                )}

                <details>
                  <summary>{s.detailTitle}</summary>
                  <ul class="plain-list">
                    {[...s.points, ...s.detail].map((p) => (
                      <li>{p}</li>
                    ))}
                  </ul>
                </details>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" id="skills" aria-labelledby="skills-h">
    <div class="wrap">
      <div class="section-head">
        <h2 id="skills-h">What I work with</h2>
      </div>
      <dl class="skills">
        {
          skills.map((s) => (
            <div>
              <dt>
                <Icon name={s.icon} />
                {s.group}
              </dt>
              <dd>{s.items}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section section-wash" id="practice" aria-labelledby="practice-h">
    <div class="wrap">
      <div class="section-head">
        <h2 id="practice-h">Beyond the build</h2>
        <p>Good systems also need clear experiences, sensible guardrails and confident users.</p>
      </div>
      <div class="practices">
        {
          practices.map((practice) => (
            <article>
              <h3>{practice.title}</h3>
              <p>{practice.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" id="background" aria-labelledby="background-h">
    <div class="wrap">
      <div class="section-head">
        <h2 id="background-h">Six years in recruitment came first</h2>
        <p>It taught me to keep asking until the real requirement shows up.</p>
      </div>

      <ul class="facts">
        <li>
          I hired and onboarded 180 contact-centre staff. Later I built the software a contact
          centre works in.
        </li>
        <li>
          I supported an applicant-tracking rollout that helped raise application completion by
          30%.
        </li>
        <li>
          I placed cohorts of STEM graduates into technology roles at global financial
          institutions.
        </li>
      </ul>

      <ol class="journey">
        {
          journey.map((j) => (
            <li>
              <p class="when">{j.when}</p>
              <div>
                <h3>{j.what}</h3>
                <p>{j.body}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <div class="sub">
        <h2 id="qualifications">Qualifications and current study</h2>
        <ul class="quals">
          {
            qualifications.map((q) => (
              <li>
                <span>{q.name}</span>
                <span class="note">{q.note}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="section closing" aria-label="Get in touch">
    <div class="wrap">
      <p>
        If you’re hiring for Power Platform work, permanent or contract,{' '}
        <a href={site.linkedin} rel="noopener me">message me on LinkedIn</a>.
      </p>
    </div>
  </section>
</Base>

<script>
  // Highlights the stage being read in the sticky stage bar.
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('.stagebar a')].map((a) => [
      a.dataset.stage,
      a,
    ]),
  );
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        links.forEach((a) => a.removeAttribute('aria-current'));
        links.get(entry.target.id)?.setAttribute('aria-current', 'true');
      }
    },
    { rootMargin: '-25% 0px -65% 0px' },
  );
  document.querySelectorAll('.stage').forEach((el) => observer.observe(el));
</script>
