---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import drawing from '../assets/macauley-drawing.svg?raw';
import { site, stages, projects, skills, journey, qualifications } from '../content/site';

const stageName = (id: string) => stages.find((s) => s.id === id)?.name ?? id;
const coveredText = (ids: string[]) => {
  const names = ids.map((id) => stageName(id).toLowerCase());
  return names.length > 1
    ? `${names.slice(0, -1).join(', ')} and ${names[names.length - 1]}`
    : names[0];
};
const [integration, ...otherProjects] = projects;
---

<Base>
  <section class="wrap hero">
    <div class="hero-top">
      <div>
        <h1>
          I’m Macauley, a Power Platform developer in Manchester. I build Canvas apps, flows and
          Dataverse systems, and I stay with them through release and support.
        </h1>
        <p class="intro">
          Much of my two years at CRM Knowledge has gone into one contact-centre CRM, with 230+
          users and nine million Dataverse records. <a href="#work">See how the work runs</a>, or
          find me on{' '}
          <a href={site.linkedin} rel="noopener me">LinkedIn</a>.
        </p>
      </div>
      <div class="portrait portrait-drawing" role="img" aria-label="A line drawing of Macauley, smiling">
        <Fragment set:html={drawing} />
      </div>
    </div>

    <nav class="lifecycle" aria-label="Delivery stages">
      <ol>
        {
          stages.map((s) => (
            <li>
              <a href={`#${s.id}`}>
                <span class="stage-name">{s.name}</span>
                <span class="stage-summary">{s.summary}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
  </section>

  <section class="section section-wash" id="work" aria-labelledby="work-h">
    <div class="wrap">
      <div class="section-head">
        <h2 id="work-h">Consultancy work, in the order it happens</h2>
        <p>
          Client work from CRM Knowledge. The clients are confidential, so there are no names or
          screenshots.
        </p>
      </div>
    </div>

    <nav class="stagebar" aria-label="Stages in this section">
      <ol class="wrap">
        {
          stages.map((s) => (
            <li>
              <a href={`#${s.id}`} data-stage={s.id}>
                {s.name}
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <div class="wrap">
      <ol class="stages">
        {
          stages.map((s) => (
            <li class="stage" id={s.id}>
              <h3>{s.name}</h3>
              <div class="stage-body">
                <p class="lead">{s.lead}</p>

                {
                  s.id === 'build' && (
                    <figure class="compare">
                      <figcaption>Contact search on a nine-million-row table</figcaption>
                      <div class="compare-row">
                        <span class="compare-label">Before</span>
                        <span class="compare-track">
                          <span class="compare-bar compare-before" />
                        </span>
                        <span class="compare-value">about 2 minutes</span>
                      </div>
                      <div class="compare-row">
                        <span class="compare-label">After</span>
                        <span class="compare-track">
                          <span class="compare-bar compare-after" />
                        </span>
                        <span class="compare-value">under 5 seconds</span>
                      </div>
                    </figure>
                  )
                }

                {
                  s.id === 'release' && (
                    <figure class="pipeline">
                      <ol>
                        <li>Dev</li>
                        <li>UAT</li>
                        <li>Production</li>
                      </ol>
                      <figcaption>
                        One managed solution moves through all three. Connection references and
                        environment variables are set per environment.
                      </figcaption>
                    </figure>
                  )
                }

                <details>
                  <summary>{s.detailTitle}</summary>
                  <ul class="plain-list">
                    {[...s.points, ...s.detail].map((p) => (
                      <li>{p}</li>
                    ))}
                  </ul>
                </details>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" id="projects" aria-labelledby="projects-h">
    <div class="wrap">
      <div class="section-head">
        <h2 id="projects-h">Four other pieces of work</h2>
        <p>The bar under each one shows which of the six stages I covered.</p>
      </div>

      <div class="projects">
        <article class="project project-wide">
          <div>
            <h3>{integration.title}</h3>
            <dl class="formula">
              <div>
                <dt>Need</dt>
                <dd>{integration.need}</dd>
              </div>
              <div>
                <dt>What I did</dt>
                <dd>{integration.did}</dd>
              </div>
              {integration.result && (
                <div>
                  <dt>Result</dt>
                  <dd>{integration.result}</dd>
                </div>
              )}
              <div>
                <dt>Built with</dt>
                <dd>{integration.tech}</dd>
              </div>
            </dl>
            <div class="covered">
              <div class="covered-bar" aria-hidden="true">
                {
                  stages.map((s) => (
                    <span class={integration.covered.includes(s.id) ? `on-${s.id}` : ''} />
                  ))
                }
              </div>
              <p>I covered {coveredText(integration.covered)}.</p>
            </div>
          </div>
          <figure>
            <div class="diagram">
              <div class="node">
                <Icon name="database" />
                <strong>Dataverse</strong>
              </div>
              <div class="node hub">
                <Icon name="flow" />
                <strong>Azure Function Apps</strong>
                <span>Validate, transform, synchronise</span>
              </div>
              <div class="stores">
                <div class="node">
                  <Icon name="database" />
                  <strong>SQL Server</strong>
                  <span>Staging layer</span>
                </div>
                <div class="node">
                  <Icon name="database" />
                  <strong>SQL Server</strong>
                  <span>Second database</span>
                </div>
              </div>
            </div>
            <figcaption class="diagram-caption">
              Three connected data stores, with the Function Apps between them.
            </figcaption>
          </figure>
        </article>

        {
          otherProjects.map((p) => (
            <article class="project">
              <h3>{p.title}</h3>
              <dl class="formula">
                <div>
                  <dt>Need</dt>
                  <dd>{p.need}</dd>
                </div>
                <div>
                  <dt>What I did</dt>
                  <dd>{p.did}</dd>
                </div>
                {p.result && (
                  <div>
                    <dt>Result</dt>
                    <dd>{p.result}</dd>
                  </div>
                )}
                <div>
                  <dt>Built with</dt>
                  <dd>{p.tech}</dd>
                </div>
              </dl>
              <div class="covered">
                <div class="covered-bar" aria-hidden="true">
                  {stages.map((s) => (
                    <span class={p.covered.includes(s.id) ? `on-${s.id}` : ''} />
                  ))}
                </div>
                <p>I covered {coveredText(p.covered)}.</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-wash" id="skills" aria-labelledby="skills-h">
    <div class="wrap">
      <div class="section-head">
        <h2 id="skills-h">What I work with</h2>
      </div>
      <dl class="skills">
        {
          skills.map((s) => (
            <div>
              <dt>
                <Icon name={s.icon} />
                {s.group}
              </dt>
              <dd>{s.items}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section" id="background" aria-labelledby="background-h">
    <div class="wrap">
      <div class="section-head">
        <h2 id="background-h">Six years in recruitment came first</h2>
        <p>It taught me to keep asking until the real requirement shows up.</p>
      </div>

      <ul class="facts">
        <li>
          I hired and onboarded 180 contact-centre staff for Interactive Investor. Later I built
          the software a contact centre works in.
        </li>
        <li>
          At Wiley Edge I supported the Greenhouse rollout, which helped raise application
          completion by 30%.
        </li>
        <li>
          I placed cohorts of STEM graduates into roles at UBS, Morgan Stanley, NatWest Markets and
          JP Morgan.
        </li>
      </ul>

      <ol class="journey">
        {
          journey.map((j) => (
            <li>
              <p class="when">{j.when}</p>
              <div>
                <h3>{j.what}</h3>
                <p>{j.body}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <div class="sub">
        <h2 id="qualifications">Qualifications and current study</h2>
        <ul class="quals">
          {
            qualifications.map((q) => (
              <li>
                <span>{q.name}</span>
                <span class="note">{q.note}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="section closing" aria-label="Get in touch">
    <div class="wrap">
      <p>
        If you’re hiring for Power Platform work, permanent or contract,{' '}
        <a href={site.linkedin} rel="noopener me">message me on LinkedIn</a>.
      </p>
    </div>
  </section>
</Base>

<script>
  // Highlights the stage being read in the sticky stage bar.
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('.stagebar a')].map((a) => [
      a.dataset.stage,
      a,
    ]),
  );
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        links.forEach((a) => a.removeAttribute('aria-current'));
        links.get(entry.target.id)?.setAttribute('aria-current', 'true');
      }
    },
    { rootMargin: '-25% 0px -65% 0px' },
  );
  document.querySelectorAll('.stage').forEach((el) => observer.observe(el));
</script>
