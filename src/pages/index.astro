---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ArchitectureDiagram from '../components/ArchitectureDiagram.astro';
import drawing from '../assets/macauley-drawing.svg?raw';
import {
  site,
  stages,
  featuredCaseStudies,
  deliveredSystems,
  practices,
  skills,
  journey,
  qualifications,
} from '../content/site';
---

<Base>
  <section class="wrap hero">
    <div class="hero-top">
      <div>
        <h1>
          I design and build Power Platform apps, automation and AI tools.
        </h1>
        <p class="intro">
          My work runs from early ideas through to production support, with a focus on reliable
          delivery and straightforward UX/UI.
          <span class="hero-links">
            <a href="#work">See the work</a>, or find me on{' '}
            <a class="external-link" href={site.linkedin} rel="noopener me">
              LinkedIn <Icon name="externalLink" />
            </a>.
          </span>
          <span class="availability">{site.location} · Remote or hybrid</span>
        </p>
      </div>
      <div class="portrait portrait-drawing" role="img" aria-label="A line drawing of Macauley, smiling">
        <Fragment set:html={drawing} />
      </div>
    </div>

    <nav class="lifecycle" aria-label="Delivery stages">
      <p class="lifecycle-label">From idea to live service</p>
      <ol>
        {
          stages.map((s) => (
            <li>
              <a href={`#${s.id}`}>
                <span class="stage-name">{s.name}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
  </section>

  <section class="section section-wash" id="work" aria-labelledby="work-h">
    <div class="wrap">
      <div class="section-head">
        <h2 id="work-h">Selected Power Platform work</h2>
        <p>
          Here are three examples of what I was asked to solve, what I did and what changed. I’ve
          left out client names and identifying screenshots.
        </p>
      </div>

      <div class="case-studies">
        {
          featuredCaseStudies.map((study) => (
            <article class="case-study">
              <div class="case-title">
                <Icon name={study.icon} />
                <h3>{study.title}</h3>
              </div>
              <div class="case-evidence">
                <dl class="formula case-formula">
                  <div>
                    <dt>Context</dt>
                    <dd>{study.context}</dd>
                  </div>
                  <div>
                    <dt>My role</dt>
                    <dd>{study.role}</dd>
                  </div>
                  <div>
                    <dt>What changed</dt>
                    <dd>{study.change}</dd>
                  </div>
                  <div>
                    <dt>Status</dt>
                    <dd>{study.status}</dd>
                  </div>
                  <div>
                    <dt>Built with</dt>
                    <dd>{study.tech}</dd>
                  </div>
                </dl>
                {study.visual && <ArchitectureDiagram type={study.visual} />}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" id="skills" aria-labelledby="skills-h">
    <div class="wrap">
      <div class="section-head">
        <h2 id="skills-h">What I work with</h2>
      </div>
      <dl class="skills">
        {
          skills.map((s) => (
            <div>
              <dt>
                <Icon name={s.icon} />
                {s.group}
              </dt>
              <dd>{s.items}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section section-wash" id="projects" aria-labelledby="projects-h">
    <div class="wrap">
      <div class="section-head">
        <h2 id="projects-h">More systems I’ve delivered</h2>
      </div>

      <div class="systems">
        {
          deliveredSystems.map((system) => (
            <details class="system">
              <summary>
                <span>
                  <span class="system-heading">{system.title}</span>
                  <span class="system-status">{system.result}</span>
                </span>
              </summary>
              <div class="system-body">
                <p>{system.body}</p>
                <p class="tech">{system.tech}</p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" id="process" aria-labelledby="process-h">
    <div class="wrap">
      <div class="section-head">
        <h2 id="process-h">How I take work from idea to live service</h2>
        <p>A short view of how I normally work, from the first conversation through to support after launch.</p>
      </div>
      <ol class="process-grid">
        {
          stages.map((s) => (
            <li id={s.id}>
              <h3>{s.name}</h3>
              <p>{s.lead}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section-wash" id="practice" aria-labelledby="practice-h">
    <div class="wrap">
      <div class="section-head">
        <h2 id="practice-h">The work around the build</h2>
      </div>
      <div class="practices">
        {
          practices.map((practice) => (
            <article>
              <h3>
                <Icon name={practice.icon} />
                {practice.title}
              </h3>
              <p>{practice.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" id="background" aria-labelledby="background-h">
    <div class="wrap">
      <div class="section-head">
        <h2 id="background-h">Five years in recruitment came first</h2>
        <p>It taught me to keep asking until the real requirement shows up.</p>
      </div>

      <ul class="facts">
        <li>
          I hired and onboarded 180 contact-centre staff. Later I built the software a contact
          centre works in.
        </li>
        <li>
          I supported an applicant-tracking rollout that helped raise application completion by
          30%.
        </li>
        <li>
          I placed cohorts of STEM graduates into technology roles at global financial
          institutions.
        </li>
      </ul>

      <details class="background-details">
        <summary>Earlier career and qualifications</summary>
        <div class="background-details-body">
          <ol class="journey">
          {
              journey.map((j) => (
              <li>
                  <p class="when">{j.when}</p>
                  <div>
                    <h3>{j.what}</h3>
                    <p>{j.body}</p>
                  </div>
              </li>
            ))
          }
          </ol>

          <div class="sub">
            <h2 id="qualifications">Qualifications and current study</h2>
            <ul class="quals">
              {
                qualifications.map((q) => (
                  <li>
                    <span>{q.name}</span>
                    <span class="note">{q.note}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </details>
    </div>
  </section>

  <section class="section closing" aria-label="Get in touch">
    <div class="wrap">
      <p>
        If you’re hiring for Power Platform work, permanent or contract,{' '}
        <a class="external-link" href={site.linkedin} rel="noopener me">
          message me on LinkedIn <Icon name="externalLink" />
        </a>.
      </p>
    </div>
  </section>
</Base>
