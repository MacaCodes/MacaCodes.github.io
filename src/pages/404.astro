---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found | Macauley" description="That page does not exist." noindex>
  <section class="wrap lost">
    <svg viewBox="0 0 120 150" role="img" aria-label="A line drawing of a small plant in a pot">
      <g fill="none" stroke="#0f2a24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M60 112V44"></path>
        <path d="M60 92c-24-2-34-15-36-32 19 0 32 11 36 32z"></path>
        <path d="M60 74c24-2 34-15 36-32-19 0-32 11-36 32z"></path>
        <path d="M60 52c-13-7-17-20-13-35 13 7 17 20 13 35z"></path>
        <path d="M38 112h44l-5 30H43z"></path>
      </g>
    </svg>
    <div>
      <h1>Nothing grows at this address.</h1>
      <p>
        The page may have moved, or the link was mistyped. Everything on this site lives on{' '}
        <a href="/">the home page</a>.
      </p>
    </div>
  </section>
</Base>
